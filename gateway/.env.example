# On-chain addresses -- fill in after running `yarn cli` -> "Deploy contracts"
RPC_URL=http://127.0.0.1:8545
STUDENTS_REGISTER_ADDRESS=
ENTRY_POINT_ADDRESS=
PAYMASTER_ADDRESS=
CHAIN_ID=31337

# SSI / DID layer
GATEWAY_URL=http://localhost:3000
# Private key of the gateway's DID -- use a Hardhat test account for local dev
GATEWAY_DID_PRIVATE_KEY=

# Signicat OIDC
# Create a sandbox app at https://developer.signicat.com
# Set redirect URI to: http://localhost:3000/kyc/callback
SIGNICAT_CLIENT_ID=
SIGNICAT_CLIENT_SECRET=
SIGNICAT_ISSUER=https://eduwallet.sandbox.signicat.com/auth/open

# VC Status Registry
# Fill in after deploying VCStatusRegistry.sol (see cli/src/interact.ts)
VC_STATUS_REGISTRY_ADDRESS=

# University wallet
# Run `yarn cli` -> "Deploy contracts" to get StudentDeployer address, then
# "Subscribe university" to get the SCA. Use Hardhat account #1 as university.
GATEWAY_UNIVERSITY_PRIVATE_KEY=
GATEWAY_UNIVERSITY_SCA=
STUDENT_DEPLOYER_ADDRESS=
